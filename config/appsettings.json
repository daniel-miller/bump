{
  "Release": {
    "Environment": "",
    "Version": "0.0.0"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "Bump": {
    "Database": {
      "ConnectionString": ""
    },
    "Mailgun": {
      "ApiKey": "",
      "Domain": "",
      "From": "Bump <bump@example.com>",
      "Region": "us"
    },
    "Services": {
      "IntervalSeconds": 60,
      "TimeoutSeconds": 5,
      "DegradedLatencyMs": 1000,
      "HistoryBars": 60,
      "AbuseContact": "bump@example.com",
      "MaintenanceWindows": [
        {
          "Start": "00:30",
          "End": "04:30",
          "TimeZone": "America/Denver"
        }
      ]
    },
    "Web": {
      "BaseUrl": ""
    },
    "Api": {
      "LogPath": "",
      "Hosting": {
        "Urls": "http://+:8080",
        "ClientSecret": ""
      },
      "AllowedOrigins": [],
      "Security": {
        "Apps": {
          "ClientSecrets": []
        },
        "Jwt": {
          "Key": "",
          "Issuer": "bump-api",
          "Audience": "bump-web"
        },
        "Cookie": {
          "Domain": "",
          "SameSite": "None",
          "Secure": true
        },
        "Tokens": {
          "PasswordResetHours": 1,
          "EmailChangeHours": 1
        }
      },
      "RateLimits": {
        "Apps": { "PermitLimit": 120, "WindowMinutes": 1 },
        "Problems": { "PermitLimit": 600, "WindowMinutes": 1 },
        "Auth": { "PermitLimit": 10, "WindowMinutes": 5 },
        "AuthLogin": { "PermitLimit": 5, "WindowMinutes": 15 },
        "Subscribe": { "PermitLimit": 3, "WindowMinutes": 10 },
        "Status": { "PermitLimit": 60, "WindowMinutes": 1 }
      },
      "Subscribers": {
        "MaxPerTenant": 10000
      }
    },
    "Worker": {
      "LogPath": "",
      "Hosting": {
        "Urls": "http://+:8081"
      },
      "Alerts": {
        "PollSeconds": 300,
        "Contact": "bump@example.com"
      },
      "Announcements": {
        "TickSeconds": 60
      }
    }
  }
}
