{
  "files.associations": {
    "*.sql": "postgres"
  },
  "eslint.workingDirectories": [
    { "pattern": "web" }
  ],
  "typescript.tsdk": "web/node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/bin": true,
    "**/obj": true,
    "src/Bump.Api/wwwroot": true
  },
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/bin/**": true,
    "**/obj/**": true
  }
}
