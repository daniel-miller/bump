/*
 * bump schema ER diagram (crow's foot notation). GENERATED FILE -
 * regenerate with db/export-schema.ps1; do not edit by hand.
 *
 * Edges go child -> parent: crow = many (child side), tee = one (parent
 * side). Non-CASCADE delete rules are labelled.
 */
digraph bump_schema {
    rankdir=LR;
    bgcolor="white";
    node [shape=box, style="filled,rounded", fillcolor="#f5f5f5", fontname="Helvetica", fontsize=11, color="#444444"];
    edge [fontname="Helvetica", fontsize=8, color="#555555", dir=both, arrowsize=0.9];

    account;
    account_email_change;
