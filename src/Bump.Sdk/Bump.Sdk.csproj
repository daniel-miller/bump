<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Bump.Sdk</PackageId>
    <Description>Client SDK for reporting exceptions to the Bump API (RFC 9457 problem details).</Description>
    <Authors>Daniel Miller</Authors>
    <RepositoryUrl>https://github.com/daniel-miller/bump</RepositoryUrl>
    <PackageProjectUrl>https://github.com/daniel-miller/bump</PackageProjectUrl>
    <VersionPrefix>0.1.0</VersionPrefix>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.11" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

</Project>
